{
  "name": "ARTurokAI",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements-lite.txt",
  "postAttachCommand": "pgrep -f 'arturokai.server' >/dev/null || nohup python -m arturokai.server --host 0.0.0.0 --port 7860 > /tmp/arturokai.log 2>&1 &",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "ARTurokAI (сайт)", "onAutoForward": "notify" }
  }
}
