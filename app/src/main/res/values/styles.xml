<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SiteBuilder" parent="@android:style/Theme.DeviceDefault">
    </style>

    <style name="Theme.SiteBuilder.Dark" parent="Theme.SiteBuilder">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
    </style>

    <style name="Theme.SiteBuilder.Beige" parent="Theme.SiteBuilder">
        <item name="android:windowBackground">@color/beige_bg</item>
        <item name="android:textColor">@color/beige_text</item>
        <item name="android:statusBarColor">@color/beige_bg</item>
    </style>

    <style name="Theme.SiteBuilder.Light" parent="Theme.SiteBuilder">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:statusBarColor">@color/light_bg</item>
    </style>
</resources>
