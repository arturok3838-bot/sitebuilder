# Образец файла секретов. Скопируйте его в файл .env и впишите свои значения:
#   cp .env.example .env
# Файл .env в .gitignore — в GitHub он НЕ попадёт. Токен/ключи никому не показывайте.

# Telegram-бот (токен от @BotFather)
ARTUROKAI_BOT_TOKEN=сюда_вставьте_НОВЫЙ_токен
# Ваши Telegram ID через запятую (узнать: напишите боту /id)
ARTUROKAI_ADMINS=сюда_ваш_id
# Адрес сайта, который бот даёт покупателям
ARTUROKAI_SITE=http://127.0.0.1:7860

# Админ создаётся сам при запуске сайта (логин и пароль придумайте свои)
ARTUROKAI_ADMIN_LOGIN=admin
ARTUROKAI_ADMIN_PASSWORD=придумайте_надёжный_пароль

# Ключи внешних нейросетей (нужны, только если будете их использовать)
# БЕСПЛАТНЫЕ модели (OpenRouter) — один бесплатный ключ без карты: https://openrouter.ai/keys
OPENROUTER_API_KEY=вставьте_бесплатный_ключ_openrouter
# Ещё бесплатные ИИ — каждый СВОЙ бесплатный ключ (без карты):
GROQ_API_KEY=         # console.groq.com  (Llama 70B, очень быстро)
GEMINI_API_KEY=       # aistudio.google.com  (Gemini Flash)
MISTRAL_API_KEY=      # console.mistral.ai  (Mistral Small)

# Платные модели (включите позже):
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
